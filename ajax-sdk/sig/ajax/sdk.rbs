module Ajax
  module Sdk
    extend Configuration

    def self.sia_events: (?refused: ^(Sia::Refusal) -> void | nil) -> Enumerator::Lazy[Sia::Event, void]
                       | (?refused: ^(Sia::Refusal) -> void | nil) { (Sia::Event) -> void } -> bot
    def self.sia_receiver: (^(Sia::Refusal) -> void | nil refused) { (Sia::Event) -> void } -> Sia::Receiver
  end
end
