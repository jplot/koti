module Ajax
  module Sdk
    module Cloud
      class Client
        include Resources

        IDENTITY: ^(String) -> String
        READ_WORDS: Array[String]
        WRITE_WORDS: Array[String]

        @settings: Configuration::Settings
        @session: Session
        @stub: untyped
        @mutex: Thread::Mutex

        def initialize: (?Configuration::Settings settings) -> void
        def session: () -> Session
        def inspect: () -> String
        def call: (String path, ?untyped request) ?{ (untyped) -> void } -> untyped
        def unary: (String path, ?untyped request) -> untyped
        def server_stream: (String path, ?untyped request) -> Enumerator[untyped, nil]
                         | (String path, ?untyped request) { (untyped) -> void } -> nil
        def client_stream: (String path, Array[untyped] requests) -> untyped
        def bidi: (String path, Array[untyped] requests) -> Enumerator[untyped, nil]
                | (String path, Array[untyped] requests) { (untyped) -> void } -> nil
        def authenticate: (String path, untyped request, Hash[String, String] metadata) -> untyped
        def metadata: () -> Hash[String, String]
        def read_only?: () -> bool

        private

        def stub: () -> untyped
        def credentials: () -> untyped
        def invoke: (Symbol kind, String path, untyped request, Hash[String, String] metadata) -> untyped
        def stream: (Symbol kind, String path, untyped request) { (untyped) -> void } -> nil
        def encoder: (String path) -> Method
        def value: (String path, String bytes) -> untyped
        def message: (String path, untyped request) -> untyped
        def settle: (String path, untyped value) -> untyped
        def refuse_write: (String path) -> void
        def read?: (String path) -> bool
        def authenticating: [T] (?^() -> bool retriable) { (Hash[String, String]) -> T } -> T
      end
    end
  end
end
