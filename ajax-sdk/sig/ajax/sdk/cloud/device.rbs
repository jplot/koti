module Ajax
  module Sdk
    module Cloud
      class Battery < Data
        attr_reader state: Symbol
        attr_reader charge: Integer
        attr_reader exact: bool

        def self.new: (state: Symbol, charge: Integer, exact: bool) -> Battery
        def self.from: (Hash[Symbol, untyped] raw) -> Battery
      end

      class Device < Data
        attr_reader id: String
        attr_reader name: String
        attr_reader kind: Symbol
        attr_reader hub_id: String?
        attr_reader room_id: String?
        attr_reader group_id: String?
        attr_reader states: Array[Symbol]
        attr_reader malfunctions: Integer
        attr_reader bypassed: bool
        attr_reader battery: Battery?
        attr_reader signal: Symbol?
        attr_reader temperature: Integer?
        attr_reader flags: Array[Symbol]
        attr_reader raw: Hash[Symbol, untyped]

        self.@flag_kinds: Array[Symbol]?

        def self.new: (id: String, name: String, kind: Symbol, hub_id: String?, room_id: String?, group_id: String?,
                       states: Array[Symbol], malfunctions: Integer, bypassed: bool, battery: Battery?, signal: Symbol?,
                       temperature: Integer?, flags: Array[Symbol], raw: Hash[Symbol, untyped]) -> Device
        def self.from: (Hash[Symbol, untyped] item) -> Device?
        def self.flag_kinds: () -> Array[Symbol]
        def self.origin: (Hash[Symbol, untyped]? common, Symbol wrapper) -> { kind: Symbol, hub_id: String? }
        def self.build: (Hash[Symbol, untyped] profile, kind: Symbol, hub_id: String?, raw: Hash[Symbol, untyped]) -> Device
        def self.statuses: (Array[Hash[Symbol, untyped]] list) -> { battery: Battery?, signal: Symbol?, temperature: Integer?, flags: Array[Symbol] }
      end
    end
  end
end
