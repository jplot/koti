module Ajax
  module Sdk
    module Cloud
      class Feed
        SOURCES: Array[Symbol]
        PAGE: Integer
        module SPACE = ::Ajax::Sdk::Cloud::Messages::Api::Mobile::V2::Common::Space
        module ORIGIN = ::Ajax::Sdk::Cloud::Messages::Api::Ecosystem::V2::Communicationsvc::Mobile::Commonmodels::Notification
        module LOG = ::Ajax::Sdk::Cloud::Messages::Api::Mobile::V2::Notification

        class Stop < StandardError
        end

        @client: Client
        @space_id: String
        @tracker: Tracker
        @queue: Thread::Queue[untyped]

        def initialize: (untyped client, String space_id, tracker: Tracker) -> void
        def each: () { (Event) -> void } -> void

        private

        def deliver: (Symbol source, untyped message, Array[[Float, String]]? marks) { (Event) -> void } -> void
        def follow: (Symbol source) -> void
        def subscribe: (Symbol source) { (untyped) -> void } -> nil
        def catch_up: () -> void
        def note_newest: () -> void
        def page_marks: (Array[Notification] notifications) -> Array[[Float, String]]
        def stream_marks: (untyped message) -> Array[[Float, String]]
        def created: (Array[Notification] page) -> LOG::StreamNotificationLogResponse::Success
      end
    end
  end
end
