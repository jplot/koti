module Ajax
  module Sdk
    module Cloud
      class Space < Data
        attr_reader id: String
        attr_reader hub_id: String?
        attr_reader name: String
        attr_reader security_state: Symbol
        attr_reader online: bool
        attr_reader raw: Hash[Symbol, untyped]

        def self.new: (id: String, hub_id: String?, name: String, security_state: Symbol, online: bool, raw: Hash[Symbol, untyped]) -> Space
        def self.from: (Hash[Symbol, untyped] raw) -> Space
      end

      module Resources
        V2: String
        GW: String
        SECURITY: String
        SPACES: String
        DEVICES: String
        NOTIFICATIONS: String

        def spaces: () -> Array[Space]
        def space: (String id) -> Space?
        def devices: (String space_id) -> Array[Device]
        def notifications: (String space_id, ?limit: Integer, ?older_than: String?, ?newer_than: String?) -> Array[Notification]
        def notification_history: (String space_id, ?limit: Integer) -> Enumerator::Lazy[Notification, untyped]
        def arm: (String space_id, ?ignore_alarms: bool) -> void
        def disarm: (String space_id) -> void
        def arm_night: (String space_id, ?ignore_alarms: bool) -> void
        def disarm_night: (String space_id) -> void

        # Provided by Client, used here.
        def call: (String path, ?untyped request) ?{ (untyped) -> void } -> untyped
        def server_stream: (String path, ?untyped request) -> Enumerator[untyped, nil]

        private

        def command: (String path, String space_id, ?ignore_alarms: bool?) -> void
        def space_locator: (String space_id) -> Hash[Symbol, untyped]
        def notification_page: (String space_id, limit: Integer, ?older_than: String?, ?newer_than: String?)
                             -> [Array[Notification], Array[Notification]]
        def newest_first: (Array[Notification] notifications) -> Array[Notification]
      end
    end
  end
end
