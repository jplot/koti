module Ajax
  module Sdk
    module Cloud
      class Rpc < Data
        attr_reader path: String
        attr_reader type: Symbol
        attr_reader request: String
        attr_reader response: String

        def self.new: (path: String, type: Symbol, request: String, response: String) -> Rpc
      end

      module Schemas
        DIRECTORY: String
        LOCK: Thread::Mutex

        @registry: Protobuf::Registry?
        @rpcs: Hash[String, Rpc]?

        def self?.registry: () -> Protobuf::Registry
        def self?.message: (String full_name) -> Protobuf::Message
        def self?.enum: (String full_name) -> Protobuf::Enum
        def self?.rpc: (String path) -> Rpc
        def self?.rpcs: () -> Hash[String, Rpc]
        def self?.descriptor_bytes: () -> String
        def self?.load_rpcs: () -> Hash[String, Rpc]
      end
    end
  end
end
