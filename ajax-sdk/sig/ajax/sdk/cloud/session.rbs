module Ajax
  module Sdk
    module Cloud
      class Session
        GATEWAY: String
        PASSWORD: String
        TOTP: String
        module LOGIN = ::Ajax::Sdk::Cloud::Messages::Api::Ecosystem::V3::Mobilegwsvc::Service

        @client: Client
        @settings: Configuration::Settings
        @token: String?
        @user_id: String?
        @mutex: Thread::Mutex

        def initialize: (Client client, Configuration::Settings settings) -> void
        def inspect: () -> String
        def ensure_login: () -> void
        def login: () -> void
        def metadata: () -> Hash[String, String]

        private

        def sign_in_flow: () -> void
        def require_credentials: () -> void
        def two_factor: (untyped request_id) -> void
        def sign_in: (String path, untyped request) -> untyped
        def login_with_totp: (untyped request_id, ?String? sent) -> void
        def totp_code: (String? sent) -> String
        def accept: (untyped success) -> nil
        def password_request: () -> LOGIN::LoginByPassword::LoginByPasswordRequest
        def totp_request: (untyped request_id, String totp) -> LOGIN::LoginByTotp::LoginByTotpRequest
        def password_hash: () -> String
        def reason: (untyped failure) -> Symbol
        def app_metadata: () -> Hash[String, String]
      end
    end
  end
end
