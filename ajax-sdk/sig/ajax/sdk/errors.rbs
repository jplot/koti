module Ajax
  module Sdk
    class Error < StandardError
    end

    class ConfigurationError < Error
    end

    module Sia
      class FrameError < Error
      end
    end

    module Cloud
      class UnknownMethodError < Error
      end

      class UnknownMessageError < Error
      end

      class ReadOnlyError < Error
      end

      class AuthenticationError < Error
        @reason: Symbol

        attr_reader reason: Symbol

        def initialize: (Symbol reason, ?String? message) -> void
      end

      class RefusedError < Error
        @reason: Symbol
        @failure: untyped
        @details: untyped

        attr_reader reason: Symbol
        attr_reader failure: untyped
        attr_reader details: untyped

        def initialize: (Symbol reason, ?String? message, ?failure: untyped, ?details: untyped) -> void
      end

      class ReadError < RefusedError
      end

      class CommandError < RefusedError
      end
    end
  end
end
