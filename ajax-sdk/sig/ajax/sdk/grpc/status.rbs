module Ajax
  module Sdk
    module Grpc
      class Error < ::Ajax::Sdk::Error
        @code: Integer
        @details: String

        attr_reader code: Integer
        attr_reader details: String

        def initialize: (Integer code, String details) -> void
      end

      class Unauthenticated < Error
      end

      class PermissionDenied < Error
      end

      class NotFound < Error
      end

      class Unavailable < Error
      end

      class DeadlineExceeded < Error
      end

      class ProtocolError < ::Ajax::Sdk::Error
      end

      module Status
        CLASSES: Hash[Integer, singleton(Error)]

        def self?.check: (Array[[String, String]] pairs) -> void
        def self?.find: (Array[[String, String]] pairs, String name) -> String?
        def self?.percent_decode: (String text) -> String
      end
    end
  end
end
