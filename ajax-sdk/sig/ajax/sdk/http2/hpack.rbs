module Ajax
  module Sdk
    module Http2
      module Hpack
        STATIC: Array[[String, String]]
        STATIC_SIZE: Integer
        STATIC_NAMES: Hash[String, Integer]

        class Decoder
          @limit: Integer
          @max_size: Integer
          @table: Array[[String, String]]
          @size: Integer

          def initialize: (?max_size: Integer) -> void
          def decode: (String bytes) -> Array[[String, String]]

          private

          def read_field: (String bytes, Integer position, Array[[String, String]] headers) -> Integer
          def indexed: (String bytes, Integer position, Array[[String, String]] headers) -> Integer
          def literal: (String bytes, Integer position, Array[[String, String]] headers, Integer prefix, index: bool) -> Integer
          def size_update: (String bytes, Integer position) -> Integer
          def read_integer: (String bytes, Integer position, Integer prefix) -> [Integer, Integer]
          def read_string: (String bytes, Integer position) -> [String, Integer]
          def lookup: (Integer index) -> [String, String]
          def add: (String name, String value) -> void
          def evict: () -> void
          def entry_size: (String name, String value) -> Integer
        end

        class Encoder
          def encode: (Array[[String, String]] headers) -> String

          private

          def integer: (Integer value, Integer prefix, Integer flags) -> String
          def string: (String text) -> String
        end
      end
    end
  end
end
