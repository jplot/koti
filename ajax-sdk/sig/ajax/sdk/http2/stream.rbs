module Ajax
  module Sdk
    module Http2
      class Stream
        INITIAL_RECV_WINDOW: Integer

        @connection: Connection
        @events: Thread::Queue
        @consumed: Integer
        @headers_seen: bool
        @error: StandardError?

        attr_reader id: Integer
        attr_reader error: StandardError?
        attr_accessor send_window: Integer

        def initialize: (Integer id, Connection connection, Integer send_window) -> void
        def each_event: () { (Array[untyped]) -> void } -> void
        def write: (String data, ?end_stream: bool) -> void
        def cancel: () -> void
        def deliver_headers: (Array[[String, String]] headers, bool end_stream) -> void
        def deliver_data: (String data, bool end_stream) -> void
        def deliver_reset: (Integer code) -> void
        def interrupt: (StandardError error) -> void
        def finish: () -> void
        def replenish: (Integer count) -> void
      end
    end
  end
end
