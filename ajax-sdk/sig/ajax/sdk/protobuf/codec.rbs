module Ajax
  module Sdk
    module Protobuf
      class Decoder
        FIXED: Hash[Integer, String]
        PACKED_WIRE: Hash[Integer, Integer]

        @registry: Registry

        def initialize: (Registry registry) -> void
        def decode: (String full_name, String bytes) -> Hash[Symbol, untyped]

        private

        def read: (Field? field, Integer wire, String bytes, Integer position, Hash[Symbol, untyped] result) -> Integer
        def store: (Field field, untyped value, Hash[Symbol, untyped] result) -> void
        def read_packed: (Field field, String bytes, Integer position, Hash[Symbol, untyped] result) -> Integer
        def read_single: (Field field, Integer wire, String bytes, Integer position) -> [untyped, Integer]
        def read_varint_value: (Field field, String bytes, Integer position) -> [untyped, Integer]
        def decode_varint: (Integer type, Integer raw) -> untyped
        def read_fixed: (Field field, String bytes, Integer position, Integer width) -> [untyped, Integer]
        def read_length_delimited: (Field field, String bytes, Integer position) -> [untyped, Integer]
        def decode_bytes: (Field field, String chunk) -> untyped
        def skip: (Integer wire, String bytes, Integer position) -> Integer
        def skip_delimited: (String bytes, Integer position) -> Integer
        def map_entry?: (Field field) -> bool
        def enum_name: (Field field, Integer number) -> (Integer | Symbol)
        def ref: (Field field) -> String
      end

      class Encoder
        WIRE: Hash[Integer, Integer]
        FIXED: Hash[Integer, String]

        @registry: Registry

        def initialize: (Registry registry) -> void
        def encode: (String full_name, Hash[Symbol, untyped] hash) -> String

        private

        def encode_field: (Field field, untyped value, String buffer) -> void
        def encode_map: (Field field, untyped value, String buffer) -> void
        def encode_packed: (Field field, untyped value, String buffer) -> void
        def encode_value: (Field field, untyped value, String buffer) -> void
        def delimited_body: (Field field, untyped value) -> String
        def scalar: (Field field, untyped value) -> String
        def varint_value: (Field field, untyped value) -> Integer
        def tag: (Field field, Integer wire) -> String
        def delimited: (String bytes) -> String
        def map_entry?: (Field field) -> bool
        def enum_number: (Field field, untyped value) -> Integer
        def ref: (Field field) -> String
      end

      class Codec
        @decoder: Decoder
        @encoder: Encoder

        def initialize: (Registry registry) -> void
        def decode: (String full_name, String bytes) -> Hash[Symbol, untyped]
        def encode: (String full_name, Hash[Symbol, untyped] hash) -> String
      end
    end
  end
end
