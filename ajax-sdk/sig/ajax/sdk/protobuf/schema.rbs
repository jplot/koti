module Ajax
  module Sdk
    module Protobuf
      class Field < Data
        attr_reader name: Symbol
        attr_reader number: Integer
        attr_reader type: Integer
        attr_reader label: Integer
        attr_reader type_name: String?
        attr_reader oneof_index: Integer?
        attr_reader packed: bool
        attr_reader proto3_optional: bool

        def self.new: (name: Symbol, number: Integer, type: Integer, label: Integer, type_name: String?, oneof_index: Integer?, packed: bool, proto3_optional: bool) -> Field
      end

      class Message < Data
        attr_reader full_name: String
        attr_reader fields: Array[Field]
        attr_reader oneofs: Array[Symbol]
        attr_reader map_entry: bool

        def self.new: (full_name: String, fields: Array[Field], oneofs: Array[Symbol], map_entry: bool) -> Message
      end

      class Enum < Data
        attr_reader full_name: String
        attr_reader values: Hash[Integer, Symbol]

        def self.new: (full_name: String, values: Hash[Integer, Symbol]) -> Enum
      end

      class Registry
        @messages: Hash[String, Message]
        @enums: Hash[String, Enum]

        def initialize: (Hash[String, Message] messages, Hash[String, Enum] enums) -> void
        def message: (String full_name) -> Message
        def enum: (String full_name) -> Enum
        def self.from_descriptor_set: (String bytes) -> Registry
        def self.list: (untyped value) -> Array[untyped]
        def self.add_file: (Hash[String, Message] messages, Hash[String, Enum] enums, untyped file) -> void
        def self.qualify: (String? package, String name) -> String
        def self.add_enum: (Hash[String, Enum] enums, String? scope, Hash[Symbol, untyped] descriptor) -> void
        def self.add_message: (Hash[String, Message] messages, Hash[String, Enum] enums, String? scope, Hash[Symbol, untyped] descriptor, String syntax) -> void
        def self.build_message: (String full, Hash[Symbol, untyped] descriptor, String syntax) -> Message
        def self.build_field: (Hash[Symbol, untyped] descriptor, String syntax) -> Field
        def self.packable?: (Integer type) -> bool
      end

      def self.descriptor_message: (String full_name, Array[[Symbol, Integer, Integer, Integer, String?]] fields) -> Message

      DESCRIPTOR: Registry
    end
  end
end
