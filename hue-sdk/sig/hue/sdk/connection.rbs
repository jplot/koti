module Hue
  module Sdk
    module Connection
      NETWORK_ERRORS: Array[singleton(Exception)]

      REQUESTS: Hash[Symbol, singleton(Net::HTTPRequest)]

      LIMITERS: Thread::Mutex

      self.@limiters: Hash[untyped, RateLimiter]

      class KeepAlive < Net::HTTP
        @socket: untyped

        private

        def begin_transport: (Net::HTTPRequest request) -> void

        def closed_abruptly?: () -> bool

        def connect: () -> void
      end

      def self?.request: (Symbol method, String path, ?body: String?, ?headers: Hash[String, String]) -> Net::HTTPResponse

      def self?.limited: (String path) { () -> Net::HTTPResponse } -> Net::HTTPResponse

      def self?.stream: (String path, ?headers: Hash[String, String]) { (String chunk) -> void } -> Net::HTTPResponse

      def self?.http: () -> Net::HTTP

      def self?.connection_key: () -> [String?, Integer, String?, String]

      def self?.transport: [T] () { () -> T } -> T

      def self?.establish: (?Integer | Float read_timeout) -> Net::HTTP

      def self?.pin: (Net::HTTP http, Configuration::Settings config) -> void

      def self?.identity_check: (String? bridge_id) -> ^(bool, OpenSSL::X509::StoreContext) -> bool

      def self?.endpoint: () -> String
    end
  end
end
