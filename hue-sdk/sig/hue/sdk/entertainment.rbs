module Hue
  module Sdk
    module Entertainment
      interface _Configuration
        def id: () -> String

        def []: (String | Symbol key) -> untyped

        def update: (**untyped attributes) -> self
      end

      module Streaming : _Configuration
        def stream: () { (Session) -> void } -> void

        private

        def snapshot: () -> Hash[String, Hash[Symbol, untyped]]

        def restoration: (Hash[String, untyped] light) -> Hash[Symbol, untyped]

        def finish: (DtlsSocket? socket, Hash[String, Hash[Symbol, untyped]] lights) -> void
      end
    end

    module Models
      class EntertainmentConfiguration < Base
        class Instance < Base::Instance
          include ::Hue::Sdk::Entertainment::Streaming
        end
      end
    end
  end
end
