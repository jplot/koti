module Hue
  module Sdk
    module Models
      module Operations
        module Create : Base
          def create: (Schema::Value request) -> Base::Instance
                    | (**untyped attributes) -> Base::Instance
        end

        module Update : Base::Instance
          def update: (Schema::Value request) -> self
                    | (**untyped attributes) -> self
        end

        module Delete : Base::Instance
          def delete: () -> true
        end
      end
    end
  end
end
