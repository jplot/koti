    module Schema
      class TimeSpan < Data
        include Value
        extend Value::ClassMethods

        attr_reader hours: Numeric?
        attr_reader minutes: Numeric?
        attr_reader seconds: Numeric?
        attr_reader milliseconds: Numeric?

        def self.new: (?hours: Numeric?, ?minutes: Numeric?, ?seconds: Numeric?, ?milliseconds: Numeric?) -> TimeSpan
        def self.from: (Hash[String, untyped] data) -> TimeSpan
      end

