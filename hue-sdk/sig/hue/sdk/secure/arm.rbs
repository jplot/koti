module Hue
  module Sdk
    module Secure
      class Arm
        GEOFENCE: Hash[Symbol?, String]

        BLOCKED: Array[Plan::status]

        DETECTIONS: Array[String]

        @home_id: String

        @path: String

        def initialize: (String home_id) -> void

        def read: () -> Schema::ArmDisarmResponse

        def state: () -> Schema::ArmDisarmStateResponse?

        def set_state: (String arm_state, ?delay: Integer?) -> void

        def update_config: (Schema::ArmDisarmSetConfigRequest request) -> void

        def sound_alarm: () -> void

        def remove: () -> void

        def delete_geofence_config: (?(:presence | :empty)? which) -> void

        private

        def moved: (Hash[String, untyped] config, Hash[String, untyped] sent) -> Array[Hash[String, untyped]]

        def picked: (Hash[String, untyped] config, Hash[String, untyped] sent) -> Array[Hash[String, untyped]]

        def changes: (Hash[String, untyped] config, Hash[String, untyped] sent, String key, *String types)
                     { (Array[Hash[String, untyped]] before, Array[Hash[String, untyped]] after) -> Array[Hash[String, untyped]] }
                   -> Array[Hash[String, untyped]]

        def gone: (Array[Hash[String, untyped]] from, Array[Hash[String, untyped]] to) -> Array[Hash[String, untyped]]

        def entries: (Hash[String, untyped]? mode, String key, Array[String] types) -> Array[Hash[String, untyped]]

        def check_plans: (Array[Hash[String, untyped]] moved, Array[Hash[String, untyped]] picked) -> void

        def check_area: (Schema::AccountSubscriptionDetailsResponse details, Hash[String, untyped] area) -> void

        def covered?: (Schema::AccountSubscriptionDetailsResponse details) -> bool
      end
    end
  end
end
