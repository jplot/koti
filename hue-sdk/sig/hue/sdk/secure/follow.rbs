module Hue
  module Sdk
    module Secure
      class Follow
        include Enumerable[Message]

        TOPICS: Array[String]

        NETWORK_ERRORS: Array[singleton(Exception)]

        AUTHORIZER: String

        ENDED: String

        REFUSED: Regexp

        class Message < Data
          attr_reader topic: String
          attr_reader payload: String

          def self.new: (topic: String, payload: String) -> Message

          def attributes: () -> untyped
        end

        @prefix: String
        @topics: Array[String]
        @keep_alive: Numeric

        def self.read: (String topic, untyped data) -> untyped

        def initialize: (String home_id, topics: Array[String], ?keep_alive: Numeric) -> void

        def each: () { (Message) -> void } -> void

        private

        def follow: () { (Message) -> void } -> void

        def relaying: (Thread::Queue relayed) { (Message) -> void } -> void

        def watch: (MQTT::Client client, Thread::Queue relayed) -> void

        def receive: (MQTT::Client client, Thread::Queue relayed) -> ::Exception

        def awaited: () -> ::Exception

        def connect: (MQTT::Client client) -> void

        def hang_up: (MQTT::Client client) -> void

        def mqtt_client: (Configuration::Settings config, String username) -> MQTT::Client

        def translated: (::Exception error) -> ::Exception

        def message: (MQTT::Packet::Publish packet) -> Message
      end
    end
  end
end
