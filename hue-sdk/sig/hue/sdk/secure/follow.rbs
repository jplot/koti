module Hue
  module Sdk
    module Secure
      class Follow
        include Enumerable[Message]
        TOPICS: Array[String]

        NETWORK_ERRORS: Array[singleton(Exception)]

        AUTHORIZER: String

        class Message < Data
          attr_reader topic: String
          attr_reader payload: String

          def self.new: (topic: String, payload: String) -> Message

          def attributes: () -> untyped
        end

        @prefix: String
        @topics: Array[String]
        @keep_alive: Numeric

        def self.read: (String topic, untyped data) -> untyped

        def initialize: (String home_id, topics: Array[String], ?keep_alive: Numeric) -> void

        def each: () { (Message) -> void } -> void

        private

        def connect: () -> Mqtt::Link

        def hello: (String username) -> String

        def transport: [T] () { () -> T } -> T

        def acknowledged: ([Integer, String]? packet) -> void

        def following: (Mqtt::Link link) -> Message?

        def message: (Mqtt::Link link, Integer type, String body) -> Message
      end
    end
  end
end
