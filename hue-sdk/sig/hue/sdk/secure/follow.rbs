module Hue
  module Sdk
    module Secure
      class Follow
        include Enumerable[Message]

        TOPICS: Array[String]

        NETWORK_ERRORS: Array[singleton(Exception)]

        AUTHORIZER: String

        ENDED: String

        REFUSED: Regexp

        class BlockFailure < StandardError
          attr_reader error: Exception

          def initialize: (Exception error) -> void
        end

        class Message < Data
          attr_reader topic: String
          attr_reader payload: String

          def self.new: (topic: String, payload: String) -> Message

          def attributes: () -> untyped
        end

        @prefix: String
        @topics: Array[String]
        @keep_alive: Numeric

        def self.read: (String topic, untyped data) -> untyped

        def initialize: (String home_id, topics: Array[String], ?keep_alive: Numeric) -> void

        def each: () { (Message) -> void } -> void

        private

        def follow: () { (Message) -> void } -> void

        def receive: (MQTT::Client client) { (Message) -> void } -> void

        def verdict: (MQTT::Client client, ::Exception error) -> ::Exception

        def arrival: () { () -> untyped } -> ::Exception?

        def ends: () -> Array[singleton(::Exception)]

        def masked: [T] (Symbol mode) { () -> T } -> T

        def connect: () -> MQTT::Client

        def mqtt_client: (Configuration::Settings config, String username) -> MQTT::Client

        def deliver: (String topic, String payload) { (Message) -> void } -> void

        def translated: (Exception error) -> Error

        def message: (String topic, String payload) -> Message
      end
    end
  end
end
