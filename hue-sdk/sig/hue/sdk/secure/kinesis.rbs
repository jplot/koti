module Hue
  module Sdk
    module Secure
      module Kinesis
        PURPOSE: String

        def self?.clip: (Schema::ClipCredentials credential, Schema::ClipMetadata metadata) -> String

        def self?.fetched: (Hash[Symbol, untyped] options, Schema::ClipMetadata metadata) -> String

        def self?.data_endpoint: (Hash[Symbol, untyped] options, String stream_name) -> String

        def self?.selector: (Schema::ClipMetadata metadata) -> Hash[Symbol, untyped]

        def self?.seconds: (untyped timestamp) -> Time
      end
    end
  end
end
