module Hue
  module Sdk
    module Secure
      module Plan
        type status = :subscribed | :experience_period | :free_tier | :experience_period_not_enabled | :unknown

        TYPES: Array[String]

        PAID: Array[String]

        STATES: Array[String]

        CAMERA: Regexp

        def self.status: (Schema::AccountSubscriptionDetailsResponse? details, String rid) -> status

        BLOCKED: Array[status]

        ACTIVE: Array[status]

        ACTIONS: Hash[status, :run | :inform_then_run | :suggest_plan | :nothing | :refetch]

        GATED: Array[String]

        def self.motion_area_selectable?: (Schema::AccountSubscriptionDetailsResponse? details, String bridge_id) -> bool

        def self.motion_area_switches?: (Schema::AccountSubscriptionDetailsResponse? details, String bridge_id) -> bool

        def self.camera_action: (Schema::AccountSubscriptionDetailsResponse? details, String camera_id)
                              -> (:run | :inform_then_run | :suggest_plan | :nothing | :refetch)

        def self.gated?: (Schema::CameraCameraServiceUpdate | Schema::CameraMicrophoneUpdate | Hash[untyped, untyped] request,
                         free_clips: bool) -> bool

        def self.covers?: (Schema::AccountSubscriptionDetailsResponse? details, Home home, motion_areas: bool) -> bool

        def self.of: (Schema::DeviceSubscriptionResponse entry) -> status

        def self.paid?: (Schema::AccountSubscriptionDetailsResponse details, String home_id) -> bool

        def self.camera_trial?: (Schema::AccountSubscriptionDetailsResponse details, Home home) -> bool

        def self.bridge_trial?: (Schema::AccountSubscriptionDetailsResponse details, Home home) -> bool

        def self.trial?: (Schema::DeviceSubscriptionResponse entry) -> bool

        def self.listed?: (Schema::DeviceSubscriptionResponse entry) -> bool
      end
    end
  end
end
