module Hue
  module Sdk
    module Secure
      # Typed values of Hue Secure, generated by schema/generate.rb from the classes of the Hue app: what
      # the cloud answers, and the requests the app sends it.
      module Schema
        class ClipCredentials < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader accessKeyId: String
          attr_reader secretAccessKey: String
          attr_reader sessionToken: String

          def self.new: (accessKeyId: String, secretAccessKey: String, sessionToken: String) -> ClipCredentials
          def self.from: (Hash[String, untyped] data) -> ClipCredentials
        end

        class ClipMetadata < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader fragment_selector_type: String
          attr_reader start_timestamp: untyped
          attr_reader end_timestamp: untyped
          attr_reader stream_name: String
          attr_reader key_envelope: String

          def self.new: (fragment_selector_type: String, start_timestamp: untyped, end_timestamp: untyped, stream_name: String, key_envelope: String) -> ClipMetadata
          def self.from: (Hash[String, untyped] data) -> ClipMetadata
        end

        class ClipCredentialsResponse < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader credential: ClipCredentials?
          attr_reader clip_metadata: ClipMetadata?

          def self.new: (?credential: ClipCredentials?, ?clip_metadata: ClipMetadata?) -> ClipCredentialsResponse
          def self.from: (Hash[String, untyped] data) -> ClipCredentialsResponse
        end

