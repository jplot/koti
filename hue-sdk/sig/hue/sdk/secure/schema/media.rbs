module Hue
  module Sdk
    module Secure
      # Typed values of Hue Secure, generated by schema/generate.rb from the classes of the Hue app: what
      # the cloud answers, and the requests the app sends it.
      module Schema
        class DownloadCameraLastSnapshotResponse < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader snapshot: String
          attr_reader timestamp: String
          attr_reader refresh_timestamp: String?

          def self.new: (snapshot: String, timestamp: String, ?refresh_timestamp: String?) -> DownloadCameraLastSnapshotResponse
          def self.from: (Hash[String, untyped] data) -> DownloadCameraLastSnapshotResponse
        end

        class DownloadTimelineEventSnapshotResponse < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader snapshot: String
          attr_reader timestamp: String

          def self.new: (snapshot: String, timestamp: String) -> DownloadTimelineEventSnapshotResponse
          def self.from: (Hash[String, untyped] data) -> DownloadTimelineEventSnapshotResponse
        end

        class PublicKeyResponse < Data
          include Sdk::Schema::Value
          extend Sdk::Schema::Value::ClassMethods

          attr_reader id: String
          attr_reader public_key: String
          attr_reader key_type: String
          attr_reader upload_date: String

          def self.new: (id: String, public_key: String, key_type: String, upload_date: String) -> PublicKeyResponse
          def self.from: (Hash[String, untyped] data) -> PublicKeyResponse
        end
      end
    end
  end
end
