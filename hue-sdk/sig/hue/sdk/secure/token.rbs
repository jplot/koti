module Hue
  module Sdk
    module Secure
      class Token < Data
        attr_reader value: String
        attr_reader refresh: String?
        attr_reader created_at: Time
        attr_reader expires_at: Time

        def self.new: (value: String, refresh: String?, created_at: Time, expires_at: Time) -> Token

        def self.from_json: (String json) -> Token

        def self.saved: () -> Token?

        def save: () -> Token

        def write: (String file) -> void

        def to_json: (*untyped) -> String

        def due?: (Time now) -> bool
      end
    end
  end
end
