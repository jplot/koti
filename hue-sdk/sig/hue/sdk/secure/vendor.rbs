# What the gem calls of the grpc gem, which ships no signatures.
module GRPC
  class ClientStub
    def initialize: (String host, untyped creds, ?timeout: Numeric) -> void

    def request_response: (String method, String request, ^(String) -> String marshal, ^(String) -> String unmarshal,
                           ?metadata: Hash[String, String]) -> String
  end

  module Core
    class ChannelCredentials
      def initialize: () -> void
    end
  end

  class BadStatus < StandardError
    attr_reader code: Integer
    attr_reader details: String
  end

  class Unauthenticated < BadStatus
  end

  class PermissionDenied < BadStatus
  end

  class Unavailable < BadStatus
  end

  class DeadlineExceeded < BadStatus
  end
end

# What the gem calls of the mqtt gem, which ships no signatures.
module MQTT
  class Exception < ::Exception
  end

  class NotConnectedException < MQTT::Exception
  end

  class Client
    def initialize: (**untyped options) -> void

    def ssl_context: () -> OpenSSL::SSL::SSLContext

    def connect: () -> void

    def subscribe: (Hash[String, Integer] topics) -> void

    def get_packet: () { (Packet::Publish packet) -> void } -> untyped

    def queue_empty?: () -> bool

    def connected?: () -> bool

    def disconnect: (?bool send_message) -> void
  end

  class Packet
    class Publish < Packet
      def topic: () -> String

      def payload: () -> String
    end
  end
end

# What the gem calls of OpenSSL that the standard library's signatures lack.
module OpenSSL
  class Cipher
    def ccm_data_len=: (Integer length) -> Integer
  end

  module PKey
    class PKey
      def derive: (PKey peer) -> String
    end
  end
end
