# frozen_string_literal: true

require 'rspec/core/rake_task'
require 'rubocop/rake_task'
require_relative 'schema/generate'

RSpec::Core::RakeTask.new(:spec)
RuboCop::RakeTask.new

namespace :yard do
  desc 'Fail unless every public object is documented'
  task :undocumented do
    output = `yard stats --list-undoc`
    puts output
    abort 'YARD: undocumented objects found' unless output.include?('100.00% documented')
  end
end

namespace :rbs do
  desc 'Validate the RBS signatures in sig/'
  task :validate do
    sh 'rbs -r singleton -r net-http -r openssl -r socket -r json -r resolv -r ipaddr -r zlib -r uri -r securerandom ' \
       '-I sig validate'
  end
end

desc 'Type-check lib/ against sig/'
task :steep do
  sh 'steep check'
end

desc 'Write the typed values of the DOP2 and Dop1 objects from lib/miele/sdk/objects/objects.json.gz'
task :generate do
  puts "wrote #{Schema::Generate.write(__dir__).size} files"
end

namespace :generate do
  desc 'Fail when the generated values differ from what objects.json.gz gives'
  task :check do
    stale = Schema::Generate.check(__dir__)
    abort "Generated files differ, run rake generate:\n#{stale.join("\n")}" if stale.any?
  end
end

task default: %i[generate:check rubocop spec yard:undocumented rbs:validate steep]
