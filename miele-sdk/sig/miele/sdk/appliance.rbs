module Miele
  module Sdk
    class Appliance
      type resource = Hash[String, untyped]

      @fab: String?

      @device_type: Symbol?

      attr_reader host: String

      def initialize: (String host) -> void

      def fab: () -> String

      def ident: () -> resource

      def settings: () -> resource

      def service: () -> resource

      def update: () -> resource

      def supervision: () -> resource

      def info: () -> resource

      def host_info: () -> resource

      def software_update: () -> resource

      def device_type: () -> Symbol

      def state: () -> State

      def start: () -> void

      def stop: () -> void

      def pause: () -> void

      def light_on: () -> void

      def light_off: () -> void

      def wake: () -> void

      def get: (String path) -> resource

      private

      def device: (String resource) -> resource

      def command: (Hash[Symbol, Integer] body) -> Connection::Response

      def change: (Hash[Symbol, Integer] body) -> void
    end
  end
end
