module Miele
  module Sdk
    class Appliance
      interface _Sleeper
        def call: (Integer seconds) -> untyped
      end

      type resource = Hash[String, untyped]

      @fab: String?

      @local: Connection::Local

      @device_type: Symbol?

      @protocol_version: Integer?

      @tech_type: String?

      @sleeper: _Sleeper

      attr_reader host: String

      def initialize: (String host, ?sleeper: _Sleeper) -> void

      def fab: () -> String

      def ident: () -> Schema::DeviceIdentification

      def settings: () -> resource

      def service: () -> resource

      def services: () -> resource

      def update: () -> resource

      def supervision: () -> Schema::SuperVision

      def info: () -> resource

      def host_info: () -> resource

      def software_update: () -> Schema::ModuleUpdateInfo

      def device_type: () -> Symbol

      def protocol_version: () -> Integer?

      def protocol: () -> Symbol

      def tech_type: () -> String?

      def state: () -> State

      def wake: () -> void

      def power_on: () -> void

      def power_off: () -> void

      def dop2: (Integer unit, Integer attribute, ?idx1: Integer?, ?idx2: Integer?) -> Dop2::Leaf

      def write_dop2: (Dop2::Leaf leaf, ?with_index: bool) -> void

      def dop1: (String request) -> String

      def fan_level=: (Integer level) -> void

      def fan_run_on_time=: (Integer minutes) -> void

      def main_light=: (bool on) -> void

      def setting: (Integer pf_id) -> Integer?

      def write_setting: (Integer pf_id, Integer value) -> void

      def get: (String path) -> resource

      private

      def channel: () -> Connection::Local

      def device: (String resource) -> resource

      def command: (Schema::DeviceState request) -> Connection::Response

      def change: (Schema::DeviceState request) -> void

      def tolerating_no_op: () { () -> untyped } -> void

      def dop2_path: (Integer unit, Integer attribute) -> String

      def power_leaf: (Integer state) -> Dop2::Leaf

      def rouse: () -> void
    end
  end
end
