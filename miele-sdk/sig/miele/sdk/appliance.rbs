module Miele
  module Sdk
    class Appliance
      include ObjectAccess
      include Resends
      include Dop1Access

      interface _Sleeper
        def call: (Integer | Float seconds) -> untyped
      end

      type resource = Hash[String, untyped]

      @fab: String?

      @local: Connection::Local

      @cloud: Cloud::Channel?

      @device_type: Symbol?

      @protocol_version: Integer?

      @tech_type: String?

      @sleeper: _Sleeper

      @clock: ^() -> Float

      attr_reader host: String

      def self.for: (String host, ?ident: Schema::DeviceIdentification?, **untyped) -> Appliance

      def initialize: (String host, ?sleeper: _Sleeper, ?clock: ^() -> Float, ?fab: String?, ?ident: Schema::DeviceIdentification?,
                       ?cloud: Cloud::Channel?) -> void

      def fab: () -> String

      def ident: () -> Schema::DeviceIdentification

      def settings: () -> resource

      def service: () -> resource

      def services: () -> resource

      def update: () -> resource

      def supervision: () -> Schema::SuperVision

      def supervise: (String device, show: bool) -> void

      def info: () -> resource

      def host_info: () -> resource

      def software_update: () -> Schema::ModuleUpdateInfo

      def device_type: () -> Symbol

      def protocol_version: () -> Integer?

      def protocol: () -> Symbol

      def tech_type: () -> String?

      def state: (?timeout: (Integer | Float)?) -> State

      def name=: (String name) -> void

      def wake: () -> void

      def dop2: (Integer unit, Integer attribute, ?idx1: Integer?, ?idx2: Integer?, ?timeout: (Integer | Float)?) -> Dop2::Leaf

      def write_dop2: (Dop2::Leaf leaf, ?with_index: bool, ?timeout: (Integer | Float)?) -> void

      def get: (String path, ?timeout: (Integer | Float)?) -> resource

      def through_cloud?: () -> bool

      private

      def send_request: (Symbol method, String path, ?body: String?, ?kind: Symbol, ?timeout: (Integer | Float)?)
                        -> Connection::Response

      def identity: () -> Schema::DeviceIdentification

      def device: (String resource, ?timeout: (Integer | Float)?) -> resource

      def command: (Schema::DeviceState request, ?timeout: (Integer | Float)?) -> Connection::Response

      def send_wake: (?timeout: (Integer | Float)?) -> void

      def dop2_path: (Integer unit, Integer attribute) -> String

      def dop2_user_request: (Integer id) -> void

      def next_time: (Time at, Time now) -> Time

      def on_day: (Time day, Time at) -> Time

      def wall_clock: (Time time) -> Rational

      def require!: (untyped condition, String reason) -> void
    end
  end
end
