module Miele
  module Sdk
    class Appliance
      include ObjectAccess

      interface _Sleeper
        def call: (Integer | Float seconds) -> untyped
      end

      type resource = Hash[String, untyped]

      @fab: String?

      @local: Connection::Local

      @module_host: String?

      @in_cloud: Array[String]

      @device_type: Symbol?

      @protocol_version: Integer?

      @tech_type: String?

      @sleeper: _Sleeper

      attr_reader host: String

      def self.for: (String host, ?ident: Schema::DeviceIdentification?, **untyped) -> Appliance

      def initialize: (String host, ?sleeper: _Sleeper, ?fab: String?, ?module_host: String?,
                       ?ident: Schema::DeviceIdentification?) -> void

      def fab: () -> String

      def ident: () -> Schema::DeviceIdentification

      def settings: () -> resource

      def service: () -> resource

      def services: () -> resource

      def update: () -> resource

      def supervision: () -> Schema::SuperVision

      def supervise: (String device, show: bool) -> void

      def info: () -> resource

      def host_info: () -> resource

      def software_update: () -> Schema::ModuleUpdateInfo

      def device_type: () -> Symbol

      def protocol_version: () -> Integer?

      def protocol: () -> Symbol

      def tech_type: () -> String?

      def state: () -> State

      def name=: (String name) -> void

      def wake: () -> void

      def dop2: (Integer unit, Integer attribute, ?idx1: Integer?, ?idx2: Integer?) -> Dop2::Leaf

      def write_dop2: (Dop2::Leaf leaf, ?with_index: bool) -> void

      def dop1: (String request) -> String

      def get: (String path) -> resource

      private

      def send_request: (Symbol method, String path, ?body: String?, ?kind: Symbol) -> Connection::Response

      def cloud_request: (Symbol method, String path, String? body, Symbol kind, String? resource) -> Connection::Response

      def identity: () -> Schema::DeviceIdentification

      def module_host: () -> String?

      def device: (String resource) -> resource

      def command: (Schema::DeviceState request) -> Connection::Response

      def change: (Schema::DeviceState request) -> void

      def tolerating_no_op: () { () -> untyped } -> void

      def dop2_path: (Integer unit, Integer attribute) -> String

      def dop2_user_request: (Integer id) -> void

      def next_time: (Time at, Time now) -> Time

      def on_day: (Time day, Time at) -> Time

      def wall_clock: (Time time) -> Rational

      def blank: (untyped klass) -> untyped

      def write_dop1_object: (untyped klass, untyped section, type: String) -> void

      def dop1_object: (untyped klass) -> untyped

      def require!: (untyped condition, String reason) -> void
    end
  end
end
