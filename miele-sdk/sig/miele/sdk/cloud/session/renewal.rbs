module Miele
  module Sdk
    module Cloud
      class Session
        module Renewal
          @mutex: Thread::Mutex

          @token: Token?

          @organization: Locales::Organization

          @sleeper: _Sleeper

          def renew: (Token expired) -> Token

          private

          def replaced: (Token expired) -> Token

          def refreshed: (Token expired) -> Token

          def refresh: (Token expired) -> Token

          def three_times: () { () -> Token } -> Token

          def mcs_refresh: (Token expired) -> Token

          def ciam_refresh: (Token expired) -> Token

          def mcs_post: (String url, String body, ?Hash[String, String] headers) -> Hash[String, untyped]

          def ciam_post: (String form) -> Hash[String, untyped]

          def lose: (Token token) -> void

          def mcs_token: (Hash[String, untyped] answer) -> Token

          def ciam_token: (Hash[String, untyped] answer) -> Token

          def client_id: () -> String
        end
      end
    end
  end
end
