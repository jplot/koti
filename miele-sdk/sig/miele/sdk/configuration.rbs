module Miele
  module Sdk
    module Configuration
      class Settings
        include Singleton
        def self.instance: () -> Settings

        attr_accessor group_id: String?
        attr_accessor group_key: String?
        attr_accessor port: Integer
        attr_accessor open_timeout: Integer | Float
        attr_accessor read_timeout: Integer | Float
        attr_accessor listener_port: Integer
        attr_accessor advertise_address: String?

        def initialize: () -> void
      end

      def config: () -> Settings

      def configure: () { (Settings) -> void } -> void
    end
  end
end
