module Miele
  module Sdk
    class CoolingAppliance < Appliance
      module Settings : Appliance
        HUMIDITY: Hash[Symbol, Integer]

        def ice_maker=: (bool on) -> void

        def ice_maker_offered?: () -> bool

        def light=: (bool on) -> void

        def light_offered?: () -> bool

        def ambient_light_mode=: (Integer value) -> void

        def ambient_light_offered?: () -> bool

        def ambient_light_choices: () -> Array[Integer]

        def presentation_light=: (bool on) -> void

        def presentation_light_offered?: () -> bool

        def set_presentation_light_intensity: (Zone zone, Integer value) -> void

        def presentation_light_intensity_offered?: () -> bool

        def presentation_light_intensity_choices: () -> Array[Integer]

        def humidity=: (Symbol level) -> void

        def humidity_offered?: () -> bool

        def humidity_choices: () -> Array[Symbol]

        def perfect_fresh=: (Integer value) -> void

        def perfect_fresh_offered?: () -> bool

        def perfect_fresh_choices: () -> Array[Integer]

        def humidifier=: (Integer value) -> void

        def humidifier_offered?: () -> bool

        def humidifier_choices: () -> Array[Integer]

        def door_alarm_delay=: (Integer seconds) -> void

        def door_alarm_delay_offered?: () -> bool

        def door_alarm_delay_choices: () -> Array[Integer]

        def light_shown?: (?State state) -> bool

        private

        def put: (String resource, String member, **untyped body) -> void

        def switch: (bool on) -> Hash[Symbol, untyped]

        def write_cooling: (String member, **untyped body) -> void

        def ambient_light_key: () -> String

        def setting_shown?: (String key) -> bool

        def picker: (Hash[String, untyped]? setting) -> Array[Integer]

        def cooling: () -> Hash[String, untyped]

        def settings_listed?: (State state) -> bool

        def presenter_light_shown?: (State state) -> bool

        def presenter_quick_action?: (State state) -> bool

        def humidity_control_shown?: (State state) -> bool

        def ambient_light_shown?: (State state, String key) -> bool

        def ambient_light_numbers: (String key) -> Array[Integer]

        def ice_maker?: () -> bool

        def wine?: () -> bool

        def rioja?: () -> bool

        def kwtus?: () -> bool

        def state_light?: () -> bool

        def presentation_light?: () -> bool
      end
    end
  end
end
