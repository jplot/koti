module Miele
  module Sdk
    module Dop2
      class DecodeError < Error
      end

      class Leaf < Data
        attr_reader unit: Integer
        attr_reader attribute: Integer
        attr_reader idx1: Integer
        attr_reader idx2: Integer
        attr_reader fields: Hash[Integer, Field]

        def self.new: (unit: Integer, attribute: Integer, idx1: Integer, idx2: Integer, fields: Hash[Integer, Field]) -> Leaf
      end

      class Field < Data
        attr_reader type: Symbol
        attr_reader value: untyped

        def self.new: (type: Symbol, value: untyped) -> Field
                    | (Symbol type, untyped value) -> Field

        def self.[]: (Symbol type, untyped value) -> Field
      end

      SCALARS: Hash[Symbol, [String, Integer]]

      TYPES: Hash[Integer, Symbol]

      CODES: Hash[Symbol, Integer]

      class Reader
        @bytes: String

        @offset: Integer

        @end: Integer

        def initialize: (String bytes) -> void

        def leaf: () -> Leaf

        private

        def fields: (Integer count) -> Hash[Integer, Field]

        def field: () -> Field

        def value: (Symbol type) -> untyped

        def scalar: (Symbol type) -> (Integer | Float | bool)

        def read: (String directive, Integer size) -> untyped
      end

      def self?.decode: (String bytes) -> Leaf

      def self?.encode: (Leaf leaf) -> String

      def self?.encode_fields: (Hash[Integer, Field] fields) -> String

      def self?.payload: (Symbol type, untyped value) -> String

      def self?.struct_bytes: (Hash[Integer, Field] fields) -> String

      def self?.sequence: (Array[untyped] items) { (untyped) -> String } -> String

      def self?.element: (Symbol type) -> Symbol

      def self?.scalar_bytes: (Symbol type, untyped value) -> String

      def self?.scalar_value: (Symbol type, untyped value, Integer size) -> (Integer | Float)

      def self?.range: (Symbol type, Integer size) -> Range[Integer]
    end
  end
end
