module Miele
  module Sdk
    class Hob < Appliance
      class Zone < Data
        attr_reader number: Integer
        attr_reader level: Float?
        attr_reader heat: Symbol?
        attr_reader booster: Integer
        attr_reader timer: Integer?
        attr_reader cookware: bool
        attr_reader bridged: bool
        attr_reader temp_control: bool
        attr_reader secondary: bool

        def self.new: (Integer number, Float? level, Symbol? heat, Integer booster, Integer? timer, bool cookware,
                       bool bridged, bool temp_control, bool secondary) -> Zone
                    | (number: Integer, level: Float?, heat: Symbol?, booster: Integer, timer: Integer?, cookware: bool,
                       bridged: bool, temp_control: bool, secondary: bool) -> Zone
      end

      class TempControl < Data
        attr_reader zone: Integer
        attr_reader level: Symbol
        attr_reader target_reached: bool
        attr_reader target: Integer
        attr_reader current: Integer

        def self.new: (Integer zone, Symbol level, bool target_reached, Integer target, Integer current) -> TempControl
                    | (zone: Integer, level: Symbol, target_reached: bool, target: Float?, current: Float?) -> TempControl
      end

      class Fan < Data
        attr_reader level: (Integer | Symbol)?
        attr_reader run_on: Integer

        def self.new: ((Integer | Symbol)? level, Integer run_on) -> Fan
                    | (level: (Integer | Symbol)?, run_on: Integer) -> Fan
      end

      module Zones : Appliance
        HEATS: Hash[Integer, Symbol]

        private

        def existing_zones: (untyped general, Integer count) -> Array[Zone]

        def zone: (untyped general, Integer number, bool doubling) -> Zone

        def raw_level: (untyped general, Integer number) -> Integer

        def level: (Integer raw, bool doubling) -> Float?

        def flexed: (Array[Zone] zones) -> Array[Zone]

        def secondary_of: (Array[Zone] pair) -> Zone?

        def timer: (Integer time) -> Integer?

        def renumbered: (Array[Zone] zones, untyped values) -> Array[Zone]
      end
    end
  end
end
