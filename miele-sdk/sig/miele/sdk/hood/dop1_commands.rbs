module Miele
  module Sdk
    class Hood < Appliance
      module Dop1Commands : Appliance
        AMBIENT_MODES: Hash[Symbol, Integer]

        DEHUMIDIFICATION_SETTINGS: Hash[Symbol, Integer]

        FRAGRANCE_ACTIONS: Hash[Symbol, Integer]

        SILENCE_KEPT: Array[Symbol]

        def configure_ambient_light: (mode: Symbol, rgb: [Integer, Integer, Integer], brightness: Integer,
                                      colour_temperature: Integer) -> void

        def dehumidification=: (Symbol mode) -> void

        def dehumidification_silent=: (bool silent) -> void

        def grease_melting=: (bool on) -> void

        def grease_melting_at: (Integer minutes) -> void

        def lights: () -> Lights?

        def dehumidification: () -> Dehumidification?

        def grease_melting: () -> GreaseMelting?

        def setting: (Integer pf_id) -> Integer?

        def write_setting: (Integer pf_id, Integer value) -> void

        private

        def dop1_ambient_light: (bool on) -> void

        def dop1_fragrance: (Symbol action) -> void

        def require_dop1!: () -> void

        def require_feature!: (bool? supported, String reason) -> void

        def require_ambient_light!: () -> void

        def write_section: (untyped object, **Integer values) -> void

        def read_drying_slot: () -> untyped
      end
    end
  end
end
