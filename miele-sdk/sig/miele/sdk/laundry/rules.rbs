module Miele
  module Sdk
    module Laundry
      module Rules : Appliance
        def supported_requests: () -> Array[Integer]

        private

        def status: (State state) -> Integer

        def offered_requests: (State state, Objects::Laundry::GlobalDeviceContext? context) -> Array[Integer]

        def request_inputs: (State state, Objects::Laundry::GlobalDeviceContext? context) -> [Symbol | Integer, Integer, Array[Integer]]

        def allowed_by_state: (Array[Integer] requests, State state) -> Array[Integer]

        def without_unset_delay: (Array[Integer] requests) -> Array[Integer]

        def delay_mode: () -> Integer

        def raw_requests: (Objects::Laundry::GlobalDeviceContext context) -> Array[Integer]

        def process_state: (Objects::Laundry::GlobalDeviceContext context) -> Integer

