module Miele
  module Sdk
    class Oven < Appliance
      include ProgramSelection
      include Requests
      include OvenState

      def power_on: () -> void

      def power_off: () -> void

      def context: () -> Objects::Oven::GlobalDeviceContext

      def program_context: () -> Objects::Oven::GlobalPsContext

      def notifications: (?second_cavity: bool) -> Objects::Oven::GlobalNtfctnShow

      def program_groups: () -> Objects::Oven::GlobalProgramGroupsComplete

      def own_programs: () -> Array[Objects::Oven::GlobalOpProgramName]

      def program_steps: () -> [Objects::Oven::GlobalOpProgramInfoCA, Array[Objects::Oven::GlobalOpProgramStepInfoCA]]

      def second_cavity_context: () -> Objects::Oven::GlobalDeviceContext2ndDevice

      def target_temperature: () -> Float?

      def core_target_temperature: () -> Float?

      def supported_requests: () -> Array[Integer]

      private

      def celsius: (Symbol parameter) -> Float?

      def under_remote_control?: (?State state) -> bool?

      def dop2?: () -> bool

      def require_dop2!: () -> void

      def offered: (Objects::Oven::GlobalDeviceContext context) -> Array[Integer]

      def power_leaf: (Integer state) -> Dop2::Leaf

      def rouse: () -> void
    end
  end
end
