module Miele
  module Sdk
    class Oven < Appliance
      module Polling : Appliance
        POLLING_DELAY: Integer

        RETRY_BASE: Float

        ACTION_TIMEOUT: Integer

        private

        def poll: (Integer | Float timeout, ?since: Float) { () -> untyped } -> untyped

        def polled: () { () -> untyped } -> [bool, untyped]

        def paused?: (Integer failures, Float since, Integer | Float timeout) -> bool
      end
    end
  end
end
