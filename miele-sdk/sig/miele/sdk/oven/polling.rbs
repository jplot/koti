module Miele
  module Sdk
    class Oven < Appliance
      module Polling : Appliance
        POLLING_DELAY: Integer

        RETRY_BASE: Float

        ACTION_TIMEOUT: Integer

        private

        def poll: (Integer | Float timeout) { () -> untyped } -> untyped

        def timed_poll: (Integer | Float timeout) { () -> untyped } -> [untyped, Float]

        def polled: () { () -> untyped } -> [bool, untyped]

        def pause: (Integer failures, Float waited, Integer | Float timeout) -> (Integer | Float)
      end
    end
  end
end
