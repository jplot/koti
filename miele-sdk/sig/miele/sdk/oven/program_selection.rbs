module Miele
  module Sdk
    class Oven < Appliance
      module ProgramSelection : Appliance
        NOW: Integer
        DELAYED_START: Integer
        MIN_VALUE: Integer

        def target_temperature=: (Integer | Float celsius) -> void

        def core_target_temperature=: (Integer | Float celsius) -> void

        def moisture=: (Integer level) -> void

        def grill_level=: (Integer level) -> void

        def browning=: (Integer level) -> void

        def doneness=: (Integer level) -> void

        def set_start_at: (Time | :now time, kept: AutomaticTimes?) -> AutomaticTimes?

        def set_end_at: (Time time, kept: AutomaticTimes?) -> AutomaticTimes?

        def duration=: (Integer seconds) -> void

        def program_context: () -> Objects::Oven::GlobalPsContext

        def set_options: (?rapid_heating: bool?, ?pre_heating: bool?, ?crisp: bool?, ?rapid_cooling: bool?, ?keep_warm: bool?) -> void

        private

        def set_parameter: (Integer id, Symbol type, untyped value) -> void

        def write_time: (Objects::Oven::GlobalPsContext context, Integer id, Integer value, AutomaticTimes? kept) -> AutomaticTimes?

        def keeps_times?: (Objects::Oven::GlobalPsContext context) -> bool

        def span: (Objects::Oven::GlobalPsContext context) -> Integer

        def date_time: (Integer seconds) -> Integer

        def program_type: (Objects::Oven::GlobalPsAttributesCCA? attributes) -> Integer?

        def phase: (Objects::Oven::GlobalPsAttributesCCA? attributes) -> Integer?

        def start_reset: () -> Objects::Oven::GlobalPsContext

        def selected_prog_id: () -> Integer

        def require_dop2!: () -> void

        def selected_program: (Objects::Oven::GlobalPsContext context) -> Integer

        def write_parameter: (Integer prog_id, Integer id, Symbol type, untyped value) -> void

        def hundredths: (Integer | Float celsius) -> Integer

        def unix_time: (Time | :now time) -> Integer

        def unix_seconds: (Time time) -> Integer
      end
    end
  end
end
