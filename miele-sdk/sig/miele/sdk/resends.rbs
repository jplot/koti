module Miele
  module Sdk
    module Resends
      @sleeper: Appliance::_Sleeper

      private

      def three_attempts: [T] () { () -> T } -> T

      def resent: [T] (?retries: Integer | Float, ?delay: Integer?, ?within: Integer | Float,
                       ?waits: Array[Integer | Float]) { () -> T } -> T

      def poll_until_shown: (Array[Integer | Float] waits, within: Integer | Float, ?first: Integer | Float) { () -> bool } -> void

      def sleep_counted: (Array[Integer | Float] waits, Integer | Float seconds) -> void

      def resent?: (ResponseError | ConnectionError error) -> bool
    end
  end
end
