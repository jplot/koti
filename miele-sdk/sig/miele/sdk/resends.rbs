module Miele
  module Sdk
    module Resends
      MONOTONIC: ^() -> Float

      DEADLINE: Symbol

      @sleeper: Appliance::_Sleeper

      @clock: ^() -> Float

      private

      def within: [T] (Integer | Float seconds) { (Float since) -> T } -> T

      def request_timeout: ((Integer | Float)? timeout) -> (Integer | Float)?

      def uncapped: [T] () { () -> T } -> T

      def three_attempts: [T] () { () -> T } -> T

      def resent: [T] (?retries: Integer | Float, ?delay: Integer?, ?within: Integer | Float,
                       ?since: Float) { () -> T } -> T

      def poll_until_shown: (since: Float, within: Integer | Float, ?first: Integer | Float) { () -> bool } -> void

      def resent?: (ResponseError | ConnectionError error) -> bool
    end
  end
end
